# Use o nome ou alias do contêiner PostgreSQL na rede DB_NETWORK.
# Use uma senha sem caracteres especiais de URL (por exemplo, gerada por openssl rand -hex 32).
DATABASE_URL=postgresql://revisa:SUBSTITUA_A_SENHA@postgres:5432/revisa

# Opcionais em desenvolvimento. Sem eles, o restante do aplicativo continua funcionando.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
