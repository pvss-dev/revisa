# Primeira etapa: use este arquivo até emitir o certificado do subdomínio.
# Copie para ~/projects/nginx/conf.d/revisa.conf na VPS.
server {
    listen 80;
    listen [::]:80;
    server_name revisa.pvss.dev.br;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
