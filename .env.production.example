# Referência para comandos manuais. O GitHub Actions cria .env.production
# automaticamente na VPS e gera POSTGRES_PASSWORD no primeiro deploy.
# Rede existente do Nginx na VPS; confirmado com docker inspect nginx.
PROXY_NETWORK=nginx_local-net

# Gere uma senha forte sem caracteres especiais de URL: openssl rand -hex 32
# Mantenha esta senha após a primeira inicialização do volume. Alterar somente
# esta variável NÃO altera a senha gravada no PostgreSQL.
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_HEXADECIMAL_FORTE

# Usada em comandos manuais. O GitHub Actions define a imagem do commit no deploy.
REVISA_IMAGE=ghcr.io/SEU_USUARIO/SEU_REPOSITORIO:latest
